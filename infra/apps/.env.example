# Copia este archivo como .env  (docker compose lo lee automaticamente). .env NO se sube a GitHub.

# --- Otras VM (IP PRIVADA de cada instancia EC2, misma VPC) ---
MQ_HOST=10.0.1.20
MQ_USER=p360
MQ_PASS=p360pass
KAFKA_HOST=10.0.1.30

# --- Azure AD (IDaaS) ---
AZURE_TENANT_ID=726876d2-e741-443b-91af-5309677e4def
API_CLIENT_ID=c7f6f983-e84b-4d1b-8f5a-da6dcac01435

# --- Perfiles: "docker" usa H2 en memoria; "docker,oracle" usa la base de datos de AWS ---
SPRING_PROFILES_ACTIVE=docker,oracle

# --- Base de datos en AWS (endpoint de RDS) ---
# Formato: jdbc:oracle:thin:@//<endpoint-rds>:1521/<nombre-servicio>   (RDS Oracle: normalmente ORCL)
ORACLE_URL=jdbc:oracle:thin:@//CAMBIAR-endpoint-rds.us-east-1.rds.amazonaws.com:1521/ORCL
ORACLE_USER=p360
ORACLE_PASSWORD=CAMBIAR

# --- CORS del BFF: URL desde donde se sirve el frontend (separadas por coma) ---
CORS_ORIGINS=http://localhost:4200,https://CAMBIAR-url-del-frontend
